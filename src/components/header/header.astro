---
import './header.css';
import Search from '../search/search.astro';
---

<header>
  <div class="nav-container">
    <h1 class="sr-only">DJ Mix Of The Week</h1>
    <div class="title">
      <a href="/">DJ Mix Of The Week</a>
    </div>
    <button id="nav-toggle" aria-label="Toggle Navigation Menu" aria-expanded="false" aria-controls="nav-menu"><span></span></button>

    <nav id="nav-menu">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/league-of-mixes">League Of Mixes</a>
      <a href="/genres">Posts By Genre</a>
      <a href="/djs">Posts By DJ</a>
      <a href="/dj-leaderboard">DJ Leaderboard</a>
      <a href="/your-djs" x-data :class="{ 'has-favs': $store.favDJs && $store.favDJs.items.length > 0 }">Your DJs</a>
    </nav>
    <section class="header-block search">
      <h2>Search:</h2>
      <Search />
    </section>
    <section
      class="header-block non-mobile recently-visited"
      x-data="{ history: [] }"
      x-init="history = JSON.parse(localStorage.getItem('djmotw_history') || '[]')"
    >
      <template x-if="history.length > 0">
        <div>
          <h2>Recently visited</h2>
          <ul>
            <template x-for="mix in history" :key="mix.slug">
              <li>
                <a :href="`/${mix.slug}`" x-text="mix.title"></a>
              </li>
            </template>
          </ul>
        </div>
      </template>
    </section>
<section class="header-block non-mobile subscribe">
      <h2>Be notified of new posts by e-mail</h2>

      <form id="subscribe-form">
        <label for="name">Name:</label>
        <input autocomplete="name" type="text" id="name" required />
        <label for="email">Email:</label>
        <input autocomplete="email" type="email" id="email" required />
        <button type="submit">Subscribe</button>
      </form>
      <p class="response" id="response-message" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>
  </div>

  <script>
    const navToggle = document.getElementById('nav-toggle') as HTMLElement;
    const navMenu = document.getElementById('nav-menu') as HTMLElement;

    navToggle.addEventListener('click', function () {
      const isOpen = !!navMenu.style.maxHeight;
      this.classList.toggle('open');

      if (isOpen) {
        navMenu.style.maxHeight = '';
        navToggle.setAttribute('aria-expanded', 'false');
        navToggle.focus();
      } else {
        navMenu.style.maxHeight = navMenu.scrollHeight + 'px';
        navToggle.setAttribute('aria-expanded', 'true');
        const firstLink = navMenu.querySelector<HTMLElement>('a, button');
        firstLink?.focus();
      }
    });

    const form = document.getElementById('subscribe-form');
    const responseMessage = document.getElementById('response-message')!;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('name') as HTMLInputElement).value;
      const email = (document.getElementById('email') as HTMLInputElement).value;

      const res = await fetch(`${import.meta.env.PUBLIC_API_BASE_URL}/wp-json/custom/v1/subscribe`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email, name }),
      });

      const data = await res.json();

      if (res.ok) {
        responseMessage.textContent = data.message;
      } else {
        responseMessage.textContent = `Error: ${data.message || 'Something went wrong'}`;
      }
    });
  </script>
</header>
