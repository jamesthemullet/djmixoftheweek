---
import Search from '../search/search.astro';
import './footer.css';
---

<footer>
  <section class="header-block mobile subscribe">
    <h2>Be notified of new posts by e-mail</h2>

    <form id="footer-subscribe-form">
      <label for="footer-name"> Name: </label>
      <input autocomplete="name" type="text" id="footer-name" required />
      <label for="footer-email"> Email: </label>
      <input autocomplete="email" type="email" id="footer-email" required />
      <button type="submit">Subscribe</button>
    </form>
    <p class="response" id="footer-response-message" role="status" aria-live="polite" aria-atomic="true"></p>
  </section>
  <section
    class="recently-visited mobile"
    x-data="{ history: [] }"
    x-init="history = JSON.parse(localStorage.getItem('djmotw_history') || '[]')"
  >
    <template x-if="history.length > 0">
      <div>
        <h2>Recently visited</h2>
        <ul>
          <template x-for="mix in history" :key="mix.slug">
            <li>
              <a :href="`/${mix.slug}`" x-text="mix.title"></a>
            </li>
          </template>
        </ul>
      </div>
    </template>
  </section>
  <Search inputId="footer-search-input" />
  <p>DJ Mix Of The Week</p>

  <script>
    import { subscribeToNewsletter } from '../../lib/subscribe';

    const form = document.getElementById('footer-subscribe-form');
    const responseMessage = document.getElementById('footer-response-message')!;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('footer-name') as HTMLInputElement).value;
      const email = (document.getElementById('footer-email') as HTMLInputElement).value;

      responseMessage.textContent = await subscribeToNewsletter(name, email);
    });
  </script>
</footer>
