---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchGraphQL } from "../../lib/api";
import "../../styles/post.css";
import "../../styles/pages.css";
import { FALLBACK_IMAGE as fallbackImage } from "../../consts";
import GET_GENRE_BY_SLUG from "../../lib/queries/getGenreBySlug";
import { capitaliseAndRemoveHyphens } from "../../lib/utils";
import type { Post } from "../../types";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

let postsByGenre: Post[] = [];

try {
	let hasNextPage = true;
	let postsAfter: string | undefined;

	while (hasNextPage) {
		const response = await fetchGraphQL(GET_GENRE_BY_SLUG, {
			slug,
			postsFirst: 100,
			postsAfter,
		});

		const genre = response?.genre;
		if (!genre) break;

		postsByGenre = postsByGenre.concat(genre.posts?.nodes || []);
		hasNextPage = genre.posts?.pageInfo?.hasNextPage ?? false;
		postsAfter = genre.posts?.pageInfo?.endCursor ?? undefined;
	}
} catch {
	console.error("Error fetching posts by genre");
}

const postsJson = JSON.stringify(
	postsByGenre.map((post) => ({
		slug: post?.slug,
		title: post?.title,
		date: post?.date,
		rating: post?.ratings?.nodes[0]?.name ?? null,
		genres: post?.genres.nodes ?? [],
		image: post?.featuredImage?.node?.sourceUrl ?? null,
		srcSet: post?.featuredImage?.node?.srcSet ?? null,
	}))
);
---

<BaseLayout
  pageTitle={capitaliseAndRemoveHyphens(slug, 'Unknown Genre')}
  description={`All posts of genre ${capitaliseAndRemoveHyphens(slug, 'Unknown Genre')}`}
  opengraphImage={postsByGenre[0]?.seo?.opengraphImage?.sourceUrl || fallbackImage}
>
  <h1>Genre: {capitaliseAndRemoveHyphens(slug, 'Unknown Genre')}</h1>
  <div
    x-data={`{
      sortBy: 'newest',
      posts: ${postsJson},
      fallback: '${fallbackImage}',
      get sortedPosts() {
        if (this.sortBy === 'rating') {
          return [...this.posts].sort((a, b) => (Number.parseFloat(b.rating) || 0) - (Number.parseFloat(a.rating) || 0));
        }
        return [...this.posts].sort((a, b) => new Date(b.date) - new Date(a.date));
      }
    }`}
  >
    <div class="sort-controls">
      <button
        @click="sortBy = 'rating'"
        :class="{ active: sortBy === 'rating' }"
        :aria-pressed="sortBy === 'rating'"
      >
        Highest Rated
      </button>
      <button
        @click="sortBy = 'newest'"
        :class="{ active: sortBy === 'newest' }"
        :aria-pressed="sortBy === 'newest'"
      >
        Newest
      </button>
    </div>

    <ul>
      <template x-for="(post, index) in sortedPosts" :key="post.slug">
        <li class="genres-list">
          <div class="image-container">
            <a :href="`/${post.slug}`">
              <img
                :src="post.image || fallback"
                :srcset="post.srcSet"
                alt=""
                sizes="(max-width: 600px) 100vw, 700px"
                width="700"
                height="466.67"
                class="featured-image"
                :loading="index < 2 ? 'eager' : 'lazy'"
              />
            </a>
            <span class="rating-badge" x-show="post.rating" x-text="post.rating"></span>
          </div>
          <h2>
            <a :href="`/${post.slug}`" x-text="post.title"></a>
          </h2>
          <ul class="genres">
            <li>
              <template x-for="(genre, i) in post.genres" :key="genre.slug">
                <span>
                  <a :href="`/genre/${genre.slug}`" rel="noopener noreferrer" x-text="genre.name"></a><span x-show="i < post.genres.length - 1">, </span>
                </span>
              </template>
            </li>
          </ul>
        </li>
      </template>
    </ul>
  </div>
</BaseLayout>
