---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchGraphQL } from '../../lib/api';
import '../../styles/post.css';
import '../../styles/pages.css';
import { FALLBACK_IMAGE as fallbackImage } from '../../consts';
import GET_DJ_BY_SLUG from '../../lib/queries/getDJBySlug';
import { capitaliseAndRemoveHyphens } from '../../lib/utils';
import type { Post } from '../../types';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

let postsByDJ: Post[] = [];

try {
  let hasNextPage = true;
  let postsAfter: string | undefined;

  while (hasNextPage) {
    const response = await fetchGraphQL(GET_DJ_BY_SLUG, { slug, postsFirst: 100, postsAfter });
    const dj = response?.dJ;
    if (!dj) break;

    postsByDJ = postsByDJ.concat(dj.posts?.nodes || []);
    hasNextPage = dj.posts?.pageInfo?.hasNextPage ?? false;
    postsAfter = dj.posts?.pageInfo?.endCursor ?? undefined;
  }
} catch {
  console.error('Error fetching posts by DJ');
}

const postsJson = JSON.stringify(
  postsByDJ.map((post) => ({
    slug: post?.slug,
    title: post?.title,
    date: post?.date,
    rating: post?.ratings?.nodes[0]?.name ?? null,
    genres: post?.genres.nodes ?? [],
    image: post?.featuredImage?.node?.sourceUrl ?? null,
    srcSet: post?.featuredImage?.node?.srcSet ?? null,
  }))
);
---

<BaseLayout
  pageTitle={capitaliseAndRemoveHyphens(slug, 'Unknown DJ')}
  description={`All posts of DJ ${capitaliseAndRemoveHyphens(slug, 'Unknown DJ')}`}
  opengraphImage={postsByDJ[0]?.seo?.opengraphImage?.sourceUrl || fallbackImage}
>
  <h1>DJ: {capitaliseAndRemoveHyphens(slug, 'Unknown DJ')}</h1>
  <button
    x-data
    @click={`$store.favDJs.toggle(${JSON.stringify(slug)}, ${JSON.stringify(capitaliseAndRemoveHyphens(slug, 'Unknown DJ'))})`}
    :aria-pressed={`$store.favDJs.has(${JSON.stringify(slug)})`}
    class="fav-btn"
    :class={`{ 'fav-btn--active': $store.favDJs.has(${JSON.stringify(slug)}) }`}
  >
    <span x-text={`$store.favDJs.has(${JSON.stringify(slug)}) ? '★ Favourited' : '☆ Favourite'`}>☆ Favourite</span>
  </button>

  {
    postsByDJ.length === 0 ? (
      <section>
        <p>
          No posts found for <strong>{capitaliseAndRemoveHyphens(slug, 'Unknown DJ')}</strong>.
        </p>
        <p>
          You can <a href="/">return to the homepage</a> or try a different DJ.
        </p>
      </section>
    ) : (
      <div
        x-data={`{
          sortBy: 'newest',
          posts: ${postsJson},
          fallback: '${fallbackImage}',
          get sortedPosts() {
            if (this.sortBy === 'rating') {
              return [...this.posts].sort((a, b) => (Number.parseFloat(b.rating) || 0) - (Number.parseFloat(a.rating) || 0));
            }
            return [...this.posts].sort((a, b) => new Date(b.date) - new Date(a.date));
          }
        }`}
      >
        <div class="sort-controls">
          <button
            @click="sortBy = 'rating'"
            :class="{ active: sortBy === 'rating' }"
            :aria-pressed="sortBy === 'rating'"
          >
            Highest Rated
          </button>
          <button
            @click="sortBy = 'newest'"
            :class="{ active: sortBy === 'newest' }"
            :aria-pressed="sortBy === 'newest'"
          >
            Newest
          </button>
        </div>

        <ul>
          <template x-for="(post, index) in sortedPosts" :key="post.slug">
            <li class="genres-list">
              <div class="image-container">
                <a :href="`/${post.slug}`">
                  <img
                    :src="post.image || fallback"
                    :srcset="post.srcSet"
                    alt=""
                    sizes="(max-width: 600px) 100vw, 700px"
                    width="700"
                    height="466.67"
                    class="featured-image"
                    :loading="index < 2 ? 'eager' : 'lazy'"
                  />
                </a>
                <span class="rating-badge" x-show="post.rating" x-text="post.rating"></span>
              </div>
              <h2>
                <a :href="`/${post.slug}`" x-text="post.title"></a>
              </h2>
              <ul class="genres">
                <li>
                  <template x-for="(genre, i) in post.genres" :key="genre.slug">
                    <span>
                      <a :href="`/genre/${genre.slug}`" rel="noopener noreferrer" x-text="genre.name"></a><span x-show="i < post.genres.length - 1">, </span>
                    </span>
                  </template>
                </li>
              </ul>
            </li>
          </template>
        </ul>
      </div>
    )
  }
</BaseLayout>
