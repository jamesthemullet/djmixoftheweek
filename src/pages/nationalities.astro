---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchGraphQL } from '../lib/api';

import '../styles/pages.css';
import GET_NATIONALITY_NAMES from '../lib/queries/getNationalityNames';
import type { Nationalities } from '../types';

let allNationalities: Nationalities = null;

try {
  allNationalities = await fetchGraphQL(GET_NATIONALITY_NAMES);
} catch (error) {
  console.error('Error fetching all nationalities:', error);
}

const nationalitiesJson = JSON.stringify(allNationalities?.nationalities.nodes ?? []);
---

<BaseLayout pageTitle="Nationalities">
  <article>
    <h1>Nationalities</h1>
    <p>
      Explore DJ mixes by nationality. Click on a nationality to view all mixes from that country.
    </p>
    <div
      x-data={`{ nationalities: ${nationalitiesJson}, sort: 'count', get sortedNationalities() { return [...this.nationalities].sort((a, b) => this.sort === 'count' ? (b.count ?? 0) - (a.count ?? 0) : a.name.localeCompare(b.name)); } }`}
    >
      <div class="sort-controls">
        <button @click="sort = 'count'" :class="{ active: sort === 'count' }">Most Mixes</button>
        <button @click="sort = 'name'" :class="{ active: sort === 'name' }">A–Z</button>
      </div>
      <ul class="genre-list">
        <template x-for="nationality in sortedNationalities" :key="nationality.id">
          <li>
            <h2>
              <a :href="`nationality/${nationality.slug}`" rel="noopener noreferrer" x-html="nationality.name"></a>
            </h2>
            <span class="genre-count" x-text="`${nationality.count ?? 0} mix${(nationality.count ?? 0) !== 1 ? 'es' : ''}`"></span>
          </li>
        </template>
      </ul>
    </div>
  </article>
</BaseLayout>
